# Set ONE of these. If both are set, TypeSafe is used unless JEV_PROVIDER says otherwise.
# TypeSafe direct:  https://console.typesafe.ai/keys
TYPESAFE_API_KEY=
# OpenRouter:       https://openrouter.ai/keys  (uses the alpha Decisions endpoint)
OPENROUTER_API_KEY=

# Optional overrides
# JEV_PROVIDER=typesafe          # which key to use when both are set: typesafe | openrouter
# JEV_FALLBACK=true              # on provider failure, retry on the other key (if set)
# JEV_MODEL=jev-latest           # primary only; openrouter default: typesafe/jev-1.13
# JEV_API_URL=                   # primary only; defaults to the provider's endpoint
# JEV_CONCURRENCY=16
# JEV_CHUNK_CHARS=60000
# JEV_MAX_ITEMS=500
